# Image finale : Nginx servant le build statique (memes assets que l'image officielle alfresco-content-app)
#
# Le build Angular (npm run build.release) se fait sur l'hote AVANT ce build Docker
# (comme dans le pipeline officiel de l'Alfresco Content App) : compiler ~1000 paquets npm
# a l'interieur du conteneur s'est avere peu fiable (coupures reseau du sandbox Docker).
# Voir frontend/alfresco-content-app/README ou le README racine pour la commande a lancer avant.
FROM nginxinc/nginx-unprivileged:1-alpine

USER root
RUN apk update && apk upgrade
USER 101

COPY frontend/alfresco-content-app/docker/default.conf.template /etc/nginx/templates/
COPY frontend/alfresco-content-app/docker/docker-entrypoint.d/* /docker-entrypoint.d/

COPY frontend/alfresco-content-app/dist/content-ce /usr/share/nginx/html/
COPY frontend/alfresco-content-app/dist/content-ce/app.config.json /etc/nginx/templates/app.config.json.template
COPY frontend/alfresco-content-app/dist/content-ce/assets/app.extensions.json /etc/nginx/templates/app.extensions.json.template

USER root
RUN chmod a+w -R /etc/nginx/conf.d
USER 101

ENV BASE_PATH=/
ENV NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx/conf.d
