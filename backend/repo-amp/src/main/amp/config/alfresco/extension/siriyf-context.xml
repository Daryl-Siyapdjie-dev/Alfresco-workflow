<?xml version='1.0' encoding='UTF-8'?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
          http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

    <!-- Registration of new models -->
    <bean id="siriyf.dictionaryBootstrap" parent="dictionaryModelBootstrap" depends-on="dictionaryBootstrap">
        <property name="models">
            <list>
                <value>alfresco/extension/models/siriyf-model.xml</value>
            </list>
        </property>
    </bean>

    <!-- Registration of custom workflow -->
    <bean id="siriyf.workflowBootstrap" parent="workflowDeployer">
        <property name="workflowDefinitions">
            <list>
                <props>
                    <prop key="engineId">activiti</prop>
                    <prop key="location">alfresco/extension/workflows/siriyf-workflow.bpmn20.xml</prop>
                    <prop key="mimetype">text/xml</prop>
                    <prop key="redeploy">true</prop>
                </props>
            </list>
        </property>
    </bean>

    <!-- Registration of Java Delegate for SIRYF Mock Transmission -->
    <bean id="siriyfTransmissionAction" class="com.asf.guinee.SiriyfTransmissionAction">
        <property name="nodeService" ref="NodeService"/>
    </bean>

</beans>
