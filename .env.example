BCRG_USERNAME=votre_utilisateur_siryf
BCRG_PASSWORD=votre_mot_de_passe_siryf

# Jeton interne partagé Alfresco <-> API (en-tête X-Internal-Token). Doit être identique des deux
# côtés ; laisser la valeur par défaut suffit en développement.
SIRIYF_API_TOKEN=siryf-dev-token

# Optionnel : nom d'un SSL bundle si la BCRG fournit une CA privée (sinon laisser vide).
BCRG_SSL_BUNDLE=
